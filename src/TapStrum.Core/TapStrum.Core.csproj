<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>TapStrum.Core</AssemblyName>
    <RootNamespace>Tapster</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TapStrum.Core.Tests" />
    <InternalsVisibleTo Include="TapStrum.Fluent" />
    <InternalsVisibleTo Include="Tapster.Core.Tests" />
    <InternalsVisibleTo Include="Tapster.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.json" />
  </ItemGroup>

</Project>
