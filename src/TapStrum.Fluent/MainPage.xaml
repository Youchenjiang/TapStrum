<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TapStrum.Fluent.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TapStrum.Fluent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:TapStrum.Fluent.Views"
    mc:Ignorable="d">

    <Grid>
        <NavigationView x:Name="NavView"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        IsPaneToggleButtonVisible="True"
                        AlwaysShowHeader="False"
                        Header="{x:Null}"
                        OpenPaneLength="180"
                        CompactPaneLength="48"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavItemTyper" Content="打字" Tag="Typer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemHolder" Content="長按" Tag="Holder">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemClicker" Content="連點" Tag="Clicker">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE962;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemMacro" Content="重放" Tag="Macro">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C8;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavItemAbout" Content="關於" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="20,12,20,16">
                <views:TyperView x:Name="TyperPanel" Visibility="Visible"/>
                <views:HolderView x:Name="HolderPanel" Visibility="Collapsed"/>
                <views:ClickerView x:Name="ClickerPanel" Visibility="Collapsed"/>
                <views:MacroView x:Name="MacroPanel" Visibility="Collapsed"/>
                <views:SettingsView x:Name="SettingsPanel" Visibility="Collapsed"/>
                <views:AboutView x:Name="AboutPanel" Visibility="Collapsed"/>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
