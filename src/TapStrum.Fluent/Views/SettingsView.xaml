<UserControl
    x:Class="TapStrum.Fluent.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
            <TextBlock x:Name="SettingsTitleText" Text="偏好設定" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="SettingsDescText" Text="自訂 TapStrum 系統常駐、開機自動啟動與視窗行為" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="0,0,8,0">
                <!-- Card 0: Interface Language -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="SettingsLangTitleText" Text="介面語言" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SettingsLangDescText" Text="選擇 TapStrum 介面顯示語言，支援即時套用"
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox x:Name="LanguageCombo" Grid.Column="1" MinWidth="180" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  SelectionChanged="LanguageCombo_SelectionChanged"/>
                    </Grid>
                </Border>

                <!-- Card 1: Start on Boot -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="SettingsBootTitleText" Text="開機自動啟動" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SettingsBootDescText" Text="於 Windows 登入時自動在背景啟動 TapStrum 並常駐於系統匣"
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="StartOnBootToggle" Grid.Column="1"
                                      OnContent="" OffContent="" VerticalAlignment="Center"
                                      Toggled="StartOnBootToggle_Toggled"/>
                    </Grid>
                </Border>

                <!-- Card 2: Start Minimized to Tray -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="SettingsStartMinTitleText" Text="啟動時最小化至系統匣" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SettingsStartMinDescText" Text="開啟應用程式時直接隱藏至右下角系統匣，不彈出主視窗干擾"
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="StartMinimizedToggle" Grid.Column="1"
                                      OnContent="" OffContent="" VerticalAlignment="Center"
                                      Toggled="StartMinimizedToggle_Toggled"/>
                    </Grid>
                </Border>

                <!-- Card 3: Minimize on Close -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="SettingsCloseToTrayTitleText" Text="點擊關閉時縮小至系統匣" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SettingsCloseToTrayDescText" Text="點擊右上角關閉按鈕時縮排至系統匣，保持全域快捷鍵隨叫隨到"
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="MinimizeOnCloseToggle" Grid.Column="1"
                                      OnContent="" OffContent="" VerticalAlignment="Center"
                                      Toggled="MinimizeOnCloseToggle_Toggled"/>
                    </Grid>
                </Border>

                <!-- Card 4: Always on Top -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="SettingsTopTitleText" Text="視窗永遠置頂" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SettingsTopDescText" Text="將 TapStrum 視窗固定於其他視窗最上層 (全域喚醒熱鍵 Ctrl+Alt+T)"
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="AlwaysOnTopToggle" Grid.Column="1"
                                      OnContent="" OffContent="" VerticalAlignment="Center"
                                      Toggled="AlwaysOnTopToggle_Toggled"/>
                    </Grid>
                </Border>

                <!-- Card 5: Global Hotkey Info -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="SettingsHkTitleText" Text="全域功能熱鍵" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="SettingsHkDescText" Text="即使在遊戲全螢幕或背景視窗，按下熱鍵亦可直接遙控所有功能"
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <Grid RowSpacing="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="HkWakeLabel" Grid.Row="0" Grid.Column="0" Text="喚醒 / 隱藏主視窗" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="Ctrl + Alt + T" FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="SemiBold"/>
                            </Border>

                            <TextBlock x:Name="HkClickerLabel" Grid.Row="1" Grid.Column="0" Text="切換滑鼠連點 / 鍵盤連打" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="F6" FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="SemiBold"/>
                            </Border>

                            <TextBlock x:Name="HkHolderLabel" Grid.Row="2" Grid.Column="0" Text="切換按鍵長按" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Border Grid.Row="2" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="F7" FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="SemiBold"/>
                            </Border>

                            <TextBlock x:Name="HkTyperLabel" Grid.Row="3" Grid.Column="0" Text="啟動自動打字機" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Border Grid.Row="3" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="F8" FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="SemiBold"/>
                            </Border>

                            <TextBlock x:Name="HkMacroLabel" Grid.Row="4" Grid.Column="0" Text="播放巨集" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Border Grid.Row="4" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="F9" FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="SemiBold"/>
                            </Border>

                            <TextBlock x:Name="HkPanicKillLabel" Grid.Row="5" Grid.Column="0" Text="緊急全部終止" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Border Grid.Row="5" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="F10" FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            </Border>

                            <TextBlock x:Name="HkPanicEscapeLabel" Grid.Row="6" Grid.Column="0" Text="緊急中斷跳出" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Border Grid.Row="6" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="Esc" FontFamily="Cascadia Code, Consolas" FontSize="11"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 6: Navigation to About -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="SettingsAboutNavTitleText" Text="版本與專案資訊" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="TapStrum Fluent v1.4.0.0 (WinUI 3 + .NET Architecture)"
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="SettingsAboutNavBtn" Grid.Column="1" Content="查看詳情" FontSize="11"
                                Click="NavigateToAbout_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
