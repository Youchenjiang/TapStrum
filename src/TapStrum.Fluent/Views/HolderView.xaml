<UserControl
    x:Class="TapStrum.Fluent.Views.HolderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="HolderScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel Spacing="10" Padding="0,0,0,16">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="HolderHeaderTitle" Text="Key Holder" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HolderHeaderDesc" Text="Holds down specified key or key combination continuously."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                </StackPanel>

                <!-- Step Timeline Pipeline Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12">
                    <StackPanel Spacing="10">
                        <!-- Pipeline Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8D7;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock x:Name="HolderPipelineTitle" Text="Key Pipeline Sequence" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HolderPipelineHint" Text="• Click any step to edit its combo using the keyboard below"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel x:Name="HolderRepeatPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="HolderRepeatLabel" Text="Repeat Loops:" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                <NumberBox x:Name="HolderRepeatBox" Width="72" Value="1" Minimum="0" SmallChange="1"
                                           FontSize="12" SpinButtonPlacementMode="Compact"
                                           ToolTipService.ToolTip="Number of sequence loops (0 = Infinite)"/>
                            </StackPanel>
                        </Grid>

                        <!-- Interactive Step Cards Container -->
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="HolderStepsContainer" Spacing="6"/>
                        </ScrollViewer>

                        <!-- Add Step Button -->
                        <Button x:Name="AddStepBtn" Click="AddStepBtn_Click" HorizontalAlignment="Stretch"
                                Style="{StaticResource SubtleButtonStyle}" CornerRadius="6" Padding="10,6"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock x:Name="AddStepBtnText" Text="Add Step to Sequence" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Visual Virtual Keyboard Controller Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="HolderVkTitle" Text="Virtual Keyboard Controller" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ActiveStepTargetHint" Text="(Editing Step #1)" FontSize="11"
                                           Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="CaptureKeyBtn" Click="CaptureKeyBtn_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon x:Name="CaptureIcon" Glyph="&#xE7C8;" FontSize="11"/>
                                        <TextBlock x:Name="CaptureKeyText" Text="Capture Physical Key" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ClearActiveStepKeysBtn" Click="ClearActiveStepKeysBtn_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE894;" FontSize="11"/>
                                        <TextBlock x:Name="ClearActiveStepKeysBtnText" Text="Clear Keys" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="KeyboardContainer" Spacing="4" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Dedicated Action Card for Key Holder -->
        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="HolderDelayLabel" Text="Delay (s):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                    <NumberBox x:Name="HolderDelayBox" Width="68" Value="3" Minimum="0" Maximum="60"
                               FontSize="12" SpinButtonPlacementMode="Compact"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="3">
                    <TextBlock x:Name="HolderStatusText" Text="Ready" FontSize="11" FontWeight="Medium"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="HolderProgressBar" Height="3" Value="0" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <Button x:Name="HolderActionBtn" Grid.Column="2" Width="136" Height="34" Click="HolderActionBtn_Click"
                        Style="{StaticResource AccentButtonStyle}" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <FontIcon x:Name="HolderActionIcon" Glyph="&#xE768;" FontSize="12"/>
                        <TextBlock x:Name="HolderActionText" Text="Start Holder (F7)" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
